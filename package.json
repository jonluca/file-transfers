{
  "name": "file-transfers",
  "version": "1.0.0",
  "private": true,
  "main": "main.ts",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "server:dev": "vite --config vite.server.config.ts",
    "server:start": "node dist/server/index.mjs",
    "server:prune-runtime-deps": "node scripts/prune-server-runtime-deps.mjs",
    "build": "vite build --config vite.server.config.ts",
    "heroku-build": "pnpm run build && node scripts/prune-server-runtime-deps.mjs",
    "start": "node dist/server/index.mjs",
    "dev": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "clean": "rm -rf android ios .expo dist node_modules",
    "ios": "expo run:ios",
    "mobile:prepare": "expo prebuild --clean",
    "mobile:dev": "expo run:ios --device",
    "mobile:android": "JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home expo run:android --device",
    "mobile:submit": "eas build --platform all --auto-submit --non-interactive",
    "macos:device": "tsx scripts/macos-transfer-device.ts",
    "android": "expo run:android",
    "auth:generate": "auth generate --config server/auth.ts --output server/db/schema/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:legacy": "tsx scripts/migrate-legacy-postgres.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@better-auth/core": "1.7.5",
    "@better-auth/expo": "^1.7.5",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@dawidzawada/bonjour-zeroconf": "link:./modules/bonjour-zeroconf",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/dom-webview": "57.0.1",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "15.1.1",
    "@hono/node-server": "^2.1.1",
    "@tanstack/query-core": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.12",
    "better-auth": "^1.7.5",
    "better-call": "1.4.0",
    "burnt": "^0.13.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-iap": "^4.7.2",
    "expo-intent-launcher": "~57.0.1",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "hono": "^4.13.8",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "lucide-react-native": "^1.47.0",
    "nanostores": "1.5.3",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-buffer": "^0.2.2",
    "react-native-nitro-http-server": "^1.9.2",
    "react-native-nitro-modules": "0.35.6",
    "react-native-purchases": "^10.10.0",
    "react-native-purchases-ui": "^10.10.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "uniwind": "^1.12.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/babel__core": "^7",
    "@types/node": "^24.13.6",
    "@types/react-dom": "~19.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "vite": "^8.3.0",
    "auth": "^1.7.5",
    "@react-native/metro-config": "0.86.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^24.13.6"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma",
      "react-native-nitro-http-server"
    ]
  }
}
